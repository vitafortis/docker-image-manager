# For `pnpm dev` / `pnpm start` outside Docker. In Docker, set these in compose.yaml.

# Where the database and key file live.
BERTH_DATA_DIR=./data

# Optional master secret. If unset, a random 256-bit key is written to $BERTH_DATA_DIR/secret.key.
# BERTH_SECRET_KEY=

# Docker Engine for the "Docker host" registry. Defaults to the local socket.
# BERTH_DOCKER_HOST=unix:///var/run/docker.sock

# Create the login on start instead of using the setup screen.
# BERTH_ADMIN_EMAIL=you@example.com
# BERTH_ADMIN_PASSWORD=
# BERTH_ADMIN_NAME=

# Set to "disabled" to skip the login screen (fully trusted networks only).
# BERTH_AUTH=disabled
